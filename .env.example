GEMINI_API_KEY=your_api_key
GEMINI_REASONING_MODEL=your_reasoning_model
# Optional; falls back to GEMINI_REASONING_MODEL.
# GEMINI_PATCH_MODEL=your_patch_model
# GITHUB_TOKEN=github_token_with_repository_contents_and_pull_request_access

# Phase 4 API MVP authentication (use independent random secrets)
# VSE_VIEWER_API_KEY=replace_with_a_random_viewer_secret
# VSE_REVIEWER_API_KEY=replace_with_a_random_reviewer_secret
# VSE_VIEWER_IDENTITY=viewer@example.com
# VSE_REVIEWER_IDENTITY=reviewer@example.com
# VSE_CORS_ORIGINS=http://localhost:3000
# VSE_REPOSITORY_ROOT=/absolute/path/to/repository/being-reviewed
# VSE_PLAYBOOK_CATEGORY=evaluation
# Number of analysis jobs that may be leased concurrently in one worker process.
# VSE_ANALYSIS_WORKER_CONCURRENCY=2
# Smooth all Gemini generation calls in this process across this request budget.
# VSE_MODEL_REQUESTS_PER_MINUTE=15
# Set these to the selected Gemini model's prices to estimate analysis cost.
# VSE_INPUT_COST_PER_MILLION=0.30
# VSE_OUTPUT_COST_PER_MILLION=2.50
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/staff_engineer_db
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/staff_engineer_test
